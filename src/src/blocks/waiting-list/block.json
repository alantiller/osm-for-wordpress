{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "osm/waiting-list",
    "title": "OSM Waiting List",
    "category": "widgets",
    "icon": "forms",
    "description": "Show the waiting-list application form selected in OSM Settings, with optional section overrides.",
    "textdomain": "online-scout-manager",
    "attributes": {
        "sectionid": {
            "type": "string",
            "default": ""
        },
        "sectionids": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "html": false
    },
    "editorScript": "osm-blocks-editor",
    "editorStyle": "osm-blocks-editor",
    "style": "osm-frontend-style",
    "render": "file:./render.php"
}
