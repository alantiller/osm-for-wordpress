{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "osm/events",
    "title": "OSM Events",
    "category": "widgets",
    "icon": "calendar-alt",
    "description": "Display the OSM events for one or more sections.",
    "textdomain": "online-scout-manager",
    "attributes": {
        "sectionid": {
            "type": "string",
            "default": ""
        },
        "sectionids": {
            "type": "string",
            "default": ""
        },
        "futureonly": {
            "type": "boolean",
            "default": false
        },
        "layout": {
            "type": "string",
            "enum": [
                "table",
                "grid",
                "vertical",
                "tiles"
            ],
            "default": "table"
        },
        "combine": {
            "type": "boolean",
            "default": false
        }
    },
    "supports": {
        "html": false
    },
    "editorScript": "osm-blocks-editor",
    "editorStyle": "osm-blocks-editor",
    "style": "osm-frontend-style",
    "render": "file:./render.php"
}
