{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "osm/patrols",
    "title": "OSM Section Points",
    "category": "widgets",
    "icon": "list-view",
    "description": "Display section patrols and member names using each section’s name formats and member exclusions.",
    "textdomain": "online-scout-manager",
    "attributes": {
        "sectionid": {
            "type": "string",
            "default": ""
        },
        "sectionids": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "html": false
    },
    "editorScript": "osm-blocks-editor",
    "editorStyle": "osm-blocks-editor",
    "style": "osm-frontend-style",
    "render": "file:./render.php"
}
